// Cloudflare Workers config: the site in website/ is served as static assets, with no Worker code yet
// (the members' backend will add a "main" script later).
// Production deploys from the prod branch and the dev branch gets its own Preview; see docs/deploying.md.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mocgb",
  "compatibility_date": "2026-10-01",
  // Serve on <name>.<subdomain>.workers.dev, and give each uploaded version its own address too.
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./website",
    // Unknown addresses get website/404.html with a 404 status
    "not_found_handling": "404-page"
  },
  // Production on mocgb.helloshep.com, and each Preview on <preview-name>.mocgb.helloshep.com
  // (so the dev branch is dev.mocgb.helloshep.com). Keep previews_enabled here: every production
  // deploy applies this route, and without it the domain would stop serving Previews.
  "routes": [
    { "pattern": "mocgb.helloshep.com", "custom_domain": true, "previews_enabled": true }
  ],
  // Lets `wrangler preview` build the dev branch's Preview. Empty: it uses the settings above.
  "previews": {}
}
